          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center"><svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            <div><div class="font-medium text-gray-900">Crypto Deposit</div><div class="text-sm text-gray-500">Make Payments Swiftly With Crypto Currency</div></div>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </main>
<footer class="text-center text-xs text-gray-500 py-6">
      Copyright © 2026. All rights reserved.
    </footer>
  </div>

  <script>
    function openSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.remove('closed');
      mw.classList.remove('full');
      ov.classList.remove('hidden');
      requestAnimationFrame(() => ov.classList.remove('opacity-0'));
    }
    function closeSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.add('closed');
      mw.classList.add('full');
      ov.classList.add('opacity-0');
      setTimeout(() => ov.classList.add('hidden'), 300);
    }
    function toggleSidebar() {
      const sn = document.getElementById('sidenav');
      if (sn.classList.contains('closed')) openSidebar();
      else closeSidebar();
    }
    function toggleProfile() {
      document.getElementById('profileMenu').classList.toggle('hidden');
    }
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileMenu');
      if (!menu) return;
      const btn = e.target.closest('button[onclick="toggleProfile()"]');
      if (!menu.contains(e.target) && !btn) menu.classList.add('hidden');
    });
  </script>
  <script type="text/javascript">
    var _smartsupp = _smartsupp || {};
    _smartsupp.key = '0acec184ba638708391cb26d405f0f81a1ac24bc';
    window.smartsupp||(function(d) {
      var s,c,o=smartsupp=function(){ o._.push(arguments)};o._=[];
      s=d.getElementsByTagName('script')[0];c=d.createElement('script');
      c.type='text/javascript';c.charset='utf-8';c.async=true;
      c.src='https://www.smartsuppchat.com/loader.js?';s.parentNode.insertBefore(c,s);
    })(document);
  </script>

<script src="../js/config.js"></script>
<script src="../js/auth.js"></script>

</body>
</html>

