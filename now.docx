    <main class="flex-1 p-4 max-w-md mx-auto w-full">
      <h1 class="text-xl font-semibold text-gray-800 mb-6">Settings</h1>
      <section class="mb-8">
        <h2 class="font-medium text-gray-800 mb-1">Email</h2>
        <p class="text-sm text-gray-500 mb-3">Your email address is an essential part of your login process.</p>
        <input type="email" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3 focus:outline-none focus:ring-2 focus:ring-slate-300">
        <button class="bg-gray-400 text-white px-6 py-2 rounded-lg text-sm font-medium">Save</button>
      </section>
      <section class="mb-8">
        <h2 class="font-medium text-gray-800 mb-1">Passcode</h2>
        <p class="text-sm text-gray-500 mb-1">Edit your login passcode.</p>
        <p class="text-sm text-gray-500 mb-3">Current Passcode</p>
        <input type="password" placeholder="Enter Passcode" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <p class="text-sm text-gray-500 mb-1">Enter new passcode</p>
        <input type="password" placeholder="Enter new passcode" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <p class="text-sm text-gray-500 mb-1">Confirm new passcode</p>
        <input type="password" placeholder="Retype new passcode" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <button class="bg-gray-400 text-white px-6 py-2 rounded-lg text-sm font-medium">Save</button>
      </section>
      <section class="mb-8">
        <h2 class="font-medium text-gray-800 mb-1">PIN</h2>
        <p class="text-sm text-gray-500 mb-1">Edit your transaction PIN.</p>
        <p class="text-sm text-gray-500 mb-3">Current PIN</p>
        <input type="password" placeholder="Enter PIN" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <p class="text-sm text-gray-500 mb-1">Enter new PIN</p>
        <input type="password" placeholder="Enter new PIN" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <p class="text-sm text-gray-500 mb-1">Confirm new PIN</p>
        <input type="password" placeholder="Retype new PIN" class="w-full border border-gray-200 rounded-lg px-4 py-3 bg-gray-50 mb-3">
        <div class="flex gap-3">
          <button class="bg-gray-400 text-white px-6 py-2 rounded-lg text-sm font-medium">Save</button>
          <button class="bg-slate-800 text-white px-6 py-2 rounded-lg text-sm font-medium">Reset PIN</button>
        </div>
      </section>
    </main>
<footer class="text-center text-xs text-gray-500 py-6">
      Copyright © 2026. All rights reserved.
    </footer>
  </div>

  <script>
    function openSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.remove('closed');
      mw.classList.remove('full');
      ov.classList.remove('hidden');
      requestAnimationFrame(() => ov.classList.remove('opacity-0'));
    }
    function closeSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.add('closed');
      mw.classList.add('full');
      ov.classList.add('opacity-0');
      setTimeout(() => ov.classList.add('hidden'), 300);
    }
    function toggleSidebar() {
      const sn = document.getElementById('sidenav');
      if (sn.classList.contains('closed')) openSidebar();
      else closeSidebar();
    }
    function toggleProfile() {
      document.getElementById('profileMenu').classList.toggle('hidden');
    }
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileMenu');
      if (!menu) return;
      const btn = e.target.closest('button[onclick="toggleProfile()"]');
      if (!menu.contains(e.target) && !btn) menu.classList.add('hidden');
    });
  </script>
  <script type="text/javascript">
