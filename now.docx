const TESTIS = [{"name":"Louis van Nuekerk","role":"Professional Trader","text":"Incredible platform. Two quick withdrawals processed in under 48 hours. I absolutely recommend Zen Nest Markets to every serious trader.","stars":5,"init":"LN","color":"#0052FF"},{"name":"James Krypto","role":"Crypto Investor","text":"The copy trading feature is a game changer. I've been following top traders and my portfolio has grown 31% in just 3 months.","stars":5,"init":"JK","color":"#9945ff"},{"name":"Agata Vincent","role":"Forex Trader","text":"Best broker I've ever used. Customer support is available 24\/7 and the platform never goes down. My go-to for forex trading.","stars":5,"init":"AV","color":"#f7931a"},{"name":"Jakub Szulc","role":"Stock Trader","text":"Great company, no issues with payouts at all. The real estate investment feature is something I have never seen elsewhere.","stars":5,"init":"JS","color":"#00d47c"},{"name":"Pro Kittisak","role":"Day Trader","text":"Execution speed is unmatched. TradingView integration is seamless. I can trade crypto and stocks from the same account.","stars":5,"init":"PK","color":"#e50914"},{"name":"Dee Winters","role":"Long-term Investor","text":"Legitimate and trustworthy. The platform is easy to use for beginners but powerful enough for experienced traders.","stars":5,"init":"DW","color":"#26a17b"}];
let rTestiIdx = 0, rTestiTimer = null;
function initRotatingTestis(){
  const dotsEl = document.getElementById('rTestiDots');
  if(!dotsEl) return;
  dotsEl.innerHTML = TESTIS.map((_,i)=>`<div class="rt-dot${i===0?' on':''}" onclick="goToTesti(${i})"></div>`).join('');
  showTesti(0);
  rTestiTimer = setInterval(()=>{rTestiIdx = (rTestiIdx+1) % TESTIS.length;showTesti(rTestiIdx);}, 4500);
}
function showTesti(i){
  const t = TESTIS[i];
  const card = document.getElementById('rotateTesti');
  if(!card) return;
  card.classList.remove('visible');
  setTimeout(()=>{
    document.getElementById('rTestiText').textContent = '"' + t.text + '"';
    document.getElementById('rTestiAv').textContent = t.init;
    document.getElementById('rTestiAv').style.background = t.color;
    document.getElementById('rTestiName').textContent = t.name;
    document.getElementById('rTestiRole').textContent = t.role;
    document.querySelectorAll('.rt-dot').forEach((d,di)=>d.classList.toggle('on', di===i));
    card.classList.add('visible');
  }, 300);
  rTestiIdx = i;
}
function goToTesti(i){
  clearInterval(rTestiTimer);
  showTesti(i);
  rTestiTimer = setInterval(()=>{rTestiIdx = (rTestiIdx+1) % TESTIS.length;showTesti(rTestiIdx);}, 4500);
}

/* â•â• NOTIFICATION PANEL â•â• */
function _notifIcon(name){
  const map = {bell:'fa-regular fa-bell', deposit:'fa-solid fa-arrow-down', withdraw:'fa-solid fa-arrow-up', trade:'fa-solid fa-chart-line', signal:'fa-solid fa-bolt', kyc:'fa-solid fa-id-card', success:'fa-solid fa-circle-check', warning:'fa-solid fa-triangle-exclamation', info:'fa-solid fa-circle-info', message:'fa-regular fa-envelope', card:'fa-regular fa-credit-card'};
  return map[name] || 'fa-regular fa-bell';
}
function _esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function _renderEmpty(){
  return '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;min-height:60vh;text-align:center;padding:40px 20px;color:#222">'
    + '<i class="fa-regular fa-bell-slash" style="font-size:2.4rem;color:#222;margin-bottom:14px"></i>'
    + '<div style="font-size:.9rem;color:#333;font-weight:500">No new notifications.</div>'
    + '<div style="font-size:.76rem;color:#222;margin-top:6px">You\'re all caught up!</div>'
    + '<a href="'+ (window.NOTIF_PAGE_URL||'#') +'" style="margin-top:18px;color:var(--blue2);font-size:.78rem;text-decoration:none">View all notifications &rarr;</a>'
    + '</div>';
}
function _renderNotifList(items){
  if(!items || items.length===0) return _renderEmpty();
  let html = '';
  items.forEach(n=>{
    const ico = _notifIcon(n.icon);
    const safeTitle = _esc(n.title||'Notification');
    const safeMsg = _esc(n.message||'');
    const safeTime = _esc(n.time||'');
    const safeId = _esc(n.id);
    const rawUrl = String(n.action_url||'').replace(/['"\\]/g,'');
    html += '<div class="np-item unread" data-id="'+ safeId +'" onclick="openNotifItem(\''+ safeId +'\',\''+ rawUrl +'\')">'
      +   '<div style="width:36px;height:36px;border-radius:10px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--blue2);font-size:.85rem"><i class="'+ ico +'"></i></div>'
      +   '<div style="flex:1;min-width:0">'
      +     '<div style="display:flex;align-items:center;justify-content:space-between;gap:8px">'
      +       '<div style="font-weight:600;font-size:.84rem;color:#eee;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+ safeTitle +'</div>'
      +       '<span class="np-new-badge" style="background:var(--blue2);color:#fff;font-size:.6rem;padding:1px 6px;border-radius:8px;font-weight:600;flex-shrink:0">NEW</span>'
      +     '</div>'
      +     '<div style="font-size:.76rem;color:#666;margin-top:3px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">'+ safeMsg +'</div>'
      +     '<div style="font-size:.68rem;color:#333;margin-top:4px">'+ safeTime +'</div>'
      +   '</div>'
      + '</div>';
  });
  html += '<div style="text-align:center;padding:14px"><a href="'+ (window.NOTIF_PAGE_URL||'#') +'" style="color:var(--blue2);font-size:.78rem;text-decoration:none">View all notifications &rarr;</a></div>';
  return html;
}
function loadNotifs(){
  const scroll = document.getElementById('notifScroll');
  if(!scroll) return;
  if(!window.NOTIF_UNREAD_URL){ scroll.innerHTML = _renderEmpty(); return; }
  scroll.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;padding:40px;color:#444;font-size:.82rem"><i class="fa-solid fa-spinner fa-spin" style="margin-right:8px"></i>Loading...</div>';
  fetch(window.NOTIF_UNREAD_URL, {headers:{'Accept':'application/json','X-Requested-With':'XMLHttpRequest'}, credentials:'same-origin'})
    .then(r=>r.ok?r.json():{count:0,notifications:[]})
    .then(data=>{
      scroll.innerHTML = _renderNotifList(data.notifications||[]);
      const badge = document.getElementById('notifBadge');
      if(badge){ const c = data.count||0; if(c>0){ badge.style.display=''; badge.textContent = c>99?'99+':c; } else { badge.style.display='none'; } }
    })
    .catch(()=>{ scroll.innerHTML = _renderEmpty(); });
}
function openNotifItem(id, url){
  if(id && window.NOTIF_READ_BASE){
    fetch(window.NOTIF_READ_BASE + '/' + id + '/read', {method:'POST', headers:{ 'Accept':'application/json'}, credentials:'same-origin'}).catch(()=>{});
  }
  if(url && url !== '#' && url !== ''){ window.location.href = url; }
}
function openNotifPage(e){
  if(e){ e.preventDefault(); e.stopPropagation(); }
  closeSb();
  const panel = document.getElementById('notifPanel');
  panel.style.transition = 'none';
  panel.style.transform = 'translateX(100%)';
  panel.style.display = 'flex';
  panel.classList.add('open');
  panel.getBoundingClientRect();
  panel.style.transition = 'transform .3s cubic-bezier(.4,0,.2,1)';
  panel.style.transform = 'translateX(0)';
  document.body.style.overflow = 'hidden';
  loadNotifs();
}
function closeNotifPage(){
  const panel = document.getElementById('notifPanel');
  panel.style.transition = 'transform .3s cubic-bezier(.4,0,.2,1)';
  panel.style.transform = 'translateX(100%)';
  document.body.style.overflow = '';
  setTimeout(()=>{ panel.classList.remove('open'); panel.style.display = 'none'; }, 320);
}
function markRead(){
  fetch(window.MARK_READ_URL, {method:'POST', headers:{ 'Accept':'application/json'}, credentials:'same-origin'})
    .then(()=>{ _markReadUI(); showToast('All marked as read','blue'); if(typeof loadNotifs==='function') loadNotifs(); })
    .catch(()=>{ _markReadUI(); showToast('Marked as read','blue'); });
}
function markReadSilent(){
  fetch(window.MARK_READ_URL, {method:'POST', headers:{ 'Accept':'application/json'}, credentials:'same-origin'}).catch(()=>{});
  _markReadUI();
}
function _markReadUI(){
  document.querySelectorAll('.np-item').forEach(i=>i.classList.remove('unread'));
  document.querySelectorAll('.np-new-badge').forEach(b=>b.remove());
  const badge = document.getElementById('notifBadge');
  if(badge) badge.style.display = 'none';
}

/* â•â• TOAST â•â• */
function showToast(msg,type){const t=document.getElementById('toast');const c={green:'var(--grn)',red:'var(--red)',blue:'var(--blue2)'};t.innerHTML=`<i class="fa-solid fa-circle-check" style="color:${c[type]||'var(--acc)'}"></i>${msg}`;t.style.opacity='1';t.style.transform='translateX(-50%) translateY(0)';setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(-50%) translateY(80px)';},3200);}

/* â•â• COPY â•â• */
function copyTxt(txt){navigator.clipboard.writeText(txt).then(()=>showToast('Copied to clipboard!','green')).catch(()=>{const el=document.createElement('textarea');el.value=txt;document.body.appendChild(el);el.select();document.execCommand('copy');document.body.removeChild(el);showToast('Copied!','green');});}

/* â•â• AI SIGNAL GENERATOR â•â• */
let sigPair = 'BTC/USD';
let sigTf   = '1H';
let sigHistory = [];
let sigGenerating = false;

function setSigPair(el, pair){
  document.querySelectorAll('.sig-pair-btn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  sigPair = pair;
}
function setSigTf(el, tf){
  document.querySelectorAll('.sig-tf-btn').forEach(b=>b.classList.remove('on'));
  el.classList.add('on');
  sigTf = tf;
}
function seededRand(seed){let s=seed;return function(){s=(s*1664525+1013904223)&0xffffffff;return(s>>>0)/0xffffffff;};}
function strToSeed(str){let h=0;for(let i=0;i<str.length;i++)h=(Math.imul(31,h)+str.charCodeAt(i))|0;return Math.abs(h);}
function generateSignal(){
  if(sigGenerating) return;
  sigGenerating = true;
  const btn = document.getElementById('sigGenBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="btn-shine"></span><i class="fa-solid fa-circle-notch fa-spin"></i> Analysing market...';
  document.getElementById('sigResultArea').innerHTML = `<div class="sig-skeleton"><div class="skel-row wide"></div><div class="skel-row short"></div><div class="skel-block"></div><div class="skel-row" style="margin-bottom:14px"></div></div>`;
  const delay = 1800 + Math.random() * 1000;
  setTimeout(()=>{
    const signal = computeSignal(sigPair, sigTf);
    renderSignalResult(signal);
    addToHistory(signal);
    renderHistory();
    btn.disabled = false;
    btn.innerHTML = '<span class="btn-shine"></span><i class="fa-solid fa-brain"></i> Generate AI Signal';
    sigGenerating = false;
  }, delay);
}
function computeSignal(pair, tf){
  const bucket = Math.floor(Date.now() / 60000);
  const seed = strToSeed(pair + tf + bucket);
  const rng = seededRand(seed);
  const isBuy = rng() > 0.42;
  const confidence = Math.round(55 + rng() * 40);
  const bases = {'BTC/USD':113200,'ETH/USD':4460,'SOL/USD':187,'EUR/USD':1.088,'AAPL':256,'TSLA':248,'GOOGL':178,'GBP/USD':1.264,'GOLD':2340};
  const base = bases[pair] || 100;
  const isCrypto = ['BTC/USD','ETH/USD','SOL/USD'].includes(pair);
  const isForex  = ['EUR/USD','GBP/USD'].includes(pair);
  const spread = base * (isCrypto ? 0.0008 : isForex ? 0.0003 : 0.0015);
  const entry  = base + (rng()-.5)*spread*4;
  const tpPct  = (0.008 + rng()*0.022) * (isBuy ? 1 : -1);
  const slPct  = (0.004 + rng()*0.012) * (isBuy ? -1 : 1);
  const tp     = entry * (1 + tpPct);
  const sl     = entry * (1 + slPct);
  const rsi    = isBuy ? (40 + rng()*25) : (55 + rng()*25);
  const macd   = isBuy ? 'Bullish crossover' : 'Bearish crossover';
  const bb     = isBuy ? (rng()>.5?'Near lower band':'Mid-band bounce') : (rng()>.5?'Near upper band':'Mid-band rejection');
  const vol    = rng()>.55 ? 'Above average' : 'Below average';
  const ema    = isBuy ? 'Price above EMA 50/200' : 'Price below EMA 50/200';
  const bullTexts = [
    `${pair} is showing strong bullish momentum on the ${tf} chart. RSI at ${rsi.toFixed(0)} indicates oversold recovery with room to run. MACD histogram turning positive suggests momentum shift. Volume confirmation supports the move. Key resistance lies near the TP target.`,
    `Technical setup on ${pair} looks constructive for longs. ${bb} with RSI divergence building at ${rsi.toFixed(0)}. ${ema}. A clean break of current structure could target the TP level with the SL providing a tight risk profile.`,
    `${pair} has formed a higher-low pattern on the ${tf} timeframe. RSI at ${rsi.toFixed(0)} recovering from oversold zone. MACD showing early bullish crossover. Volume is ${vol.toLowerCase()}. Risk/reward ratio looks favourable for a long entry here.`
  ];
  const bearTexts = [
    `${pair} is exhibiting distribution signs on the ${tf} chart. RSI at ${rsi.toFixed(0)} approaching overbought levels. MACD momentum fading with histogram declining. ${bb}. Bears appear in control and a push toward the TP target looks probable.`,
    `Bearish structure developing on ${pair}. ${ema} with RSI at ${rsi.toFixed(0)} showing rejection from overbought zone. ${bb}. Volume is ${vol.toLowerCase()}, indicating weak buying pressure at current levels. A short position with defined SL offers a solid setup.`,
    `${pair} showing signs of exhaustion on the ${tf} chart. Failed breakout with RSI at ${rsi.toFixed(0)} rolling over. ${macd} on MACD. Supply zone overhead adding confluence to the short setup targeting the marked TP level.`
  ];
  const texts = isBuy ? bullTexts : bearTexts;
  const analysisText = texts[Math.floor(rng()*texts.length)];
  const tags = [];
  if(isBuy){
    tags.push({lbl:`RSI ${rsi.toFixed(0)}`,cls:'bull'});
    tags.push({lbl:'MACD Bull',cls:'bull'});
    tags.push({lbl:bb,cls:rng()>.4?'bull':'neut'});
    tags.push({lbl:`Vol: ${vol}`,cls:vol==='Above average'?'bull':'neut'});
    tags.push({lbl:ema,cls:'bull'});
  } else {
    tags.push({lbl:`RSI ${rsi.toFixed(0)}`,cls:'bear'});
    tags.push({lbl:'MACD Bear',cls:'bear'});
    tags.push({lbl:bb,cls:rng()>.4?'bear':'neut'});
    tags.push({lbl:`Vol: ${vol}`,cls:vol==='Above average'?'bear':'neut'});
    tags.push({lbl:ema,cls:'bear'});
  }
  const dec = isForex ? 4 : isCrypto ? (base>1000?2:3) : 2;
  return {pair, tf, isBuy, confidence, entry:entry.toFixed(dec), tp:tp.toFixed(dec), sl:sl.toFixed(dec), analysisText, tags, time: new Date().toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'})};
}
function renderSignalResult(s){
  const confColor = s.confidence >= 80 ? 'var(--grn)' : s.confidence >= 65 ? 'var(--ylw)' : 'var(--red)';
  const tagsHtml = s.tags.map(t=>`<span class="sig-ind-tag ${t.cls}">${t.lbl}</span>`).join('');
  const pairDir = s.pair + ' ' + (s.isBuy ? 'BUY' : 'SELL') + ' | Entry: ' + s.entry + ' | TP: ' + s.tp + ' | SL: ' + s.sl;
  document.getElementById('sigResultArea').innerHTML = `
  <div class="sig-result">
    <div class="sig-result-top">
      <div class="sig-pair-badge">
        <div style="font-family:'Sora',sans-serif;font-weight:600;font-size:1rem">${s.pair}</div>
        <span class="sig-tf-badge">${s.tf}</span>
      </div>
      <div class="sig-direction ${s.isBuy?'buy':'sell'}">
        <i class="fa-solid fa-arrow-${s.isBuy?'up':'down'}"></i>
        ${s.isBuy ? 'BUY / LONG' : 'SELL / SHORT'}
      </div>
    </div>
    <div class="sig-levels">
      <div class="sig-level"><div class="sig-level-lbl">Entry</div><div class="sig-level-val entry">${s.entry}</div></div>
      <div class="sig-level"><div class="sig-level-lbl">Take Profit</div><div class="sig-level-val tp">${s.tp}</div></div>
      <div class="sig-level"><div class="sig-level-lbl">Stop Loss</div><div class="sig-level-val sl">${s.sl}</div></div>
    </div>
    <div class="sig-confidence">
      <span class="sig-conf-lbl">AI Confidence</span>
      <div class="sig-conf-bar"><div class="sig-conf-fill" style="width:0%;background:${confColor}" id="confFill"></div></div>
      <span class="sig-conf-pct" style="color:${confColor}">${s.confidence}%</span>
    </div>
    <div class="sig-indicators">${tagsHtml}</div>
    <div class="sig-analysis">
      <div class="sig-analysis-lbl"><i class="fa-solid fa-brain" style="color:#2a2a2a"></i> AI Analysis</div>
      <div class="sig-analysis-text">${s.analysisText}</div>
    </div>
    <div style="padding:12px 15px;background:#0a0a0a;border-top:1px solid #111;display:flex;gap:8px">
      <button class="btn-full btn-blue" style="padding:11px;font-size:.82rem;flex:1" onclick="showToast('Opening trade for ${s.pair}...','blue')">
        <i class="fa-solid fa-bolt"></i> Trade This Signal
      </button>
      <button style="width:44px;height:44px;border-radius:10px;border:1px solid #1e1e1e;background:#111;color:#444;cursor:pointer;flex-shrink:0;font-size:.8rem;display:flex;align-items:center;justify-content:center" onclick="copyTxt('${pairDir.replace(/'/g,"\\'")}')"><i class="fa-regular fa-copy"></i></button>
    </div>
  </div>`;
  setTimeout(()=>{const fill = document.getElementById('confFill');if(fill) fill.style.width = s.confidence + '%';}, 100);
}
function addToHistory(s){sigHistory.unshift(s);if(sigHistory.length > 6) sigHistory.pop();}
function renderHistory(){
  if(!sigHistory.length) return;
  const rows = sigHistory.map(s=>`
    <div class="sig-hist-row">
      <div class="sig-hist-l">
        <div class="sig-hist-dir ${s.isBuy?'buy':'sell'}">${s.isBuy?'B':'S'}</div>
        <div><div class="sig-hist-pair">${s.pair}</div><div class="sig-hist-tf">${s.tf} Â· ${s.time}</div></div>
      </div>
      <div class="sig-hist-r">
        <div class="sig-hist-conf" style="color:${s.confidence>=80?'var(--grn)':s.confidence>=65?'var(--ylw)':'var(--red)'}">${s.confidence}%</div>
        <div class="sig-hist-time">${s.isBuy?'â–² Long':'â–¼ Short'}</div>
      </div>
    </div>`).join('');
  const histArea = document.getElementById('sigHistArea');
  if(histArea) histArea.innerHTML = `<div class="sig-hist-card"><div class="sig-hist-hdr"><i class="fa-solid fa-clock-rotate-left"></i> Recent Signals</div>${rows}</div>`;
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   DEPOSIT â€” step HTML builders
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
let depStep=1, depMethodIdx=null, depNetwork=null, depAmt=0, depProofFile=null;

function setDepCont(on, lbl='Continue'){
  const b = document.getElementById('depContBtn');
  if(!b) return;
  b.className = 'cont-btn ' + (on ? 'on' : 'off');
  b.innerHTML = `<i class="fa-solid fa-arrow-right"></i> ${lbl}`;
}

function renderDepStep(){
  const body = document.getElementById('depBody');
  if(!body) return;
  const backLbl = document.getElementById('depBackLbl');
  if(backLbl) backLbl.textContent = depStep === 1 ? 'Close' : 'Back';
  if(depStep === 1){
    const titleEl = document.getElementById('depTitle');
    if(titleEl) titleEl.textContent = 'Select Payment Method';
    body.innerHTML = depStep1HTML();
    setDepCont(depMethodIdx !== null);
    return;
  }
  if(depStep === 2){
    const titleEl = document.getElementById('depTitle');
    if(titleEl) titleEl.textContent = 'Enter Amount';
    body.innerHTML = depStep2HTML();
    setDepCont(depAmt >= 10);
    return;
  }
  if(depStep === 3){
    const m = CRYPTO_METHODS[depMethodIdx];
    if(m.nets.length === 1){ depNetwork = m.nets[0]; depStep = 4; renderDepStep(); return; }
    if(!depNetwork) depNetwork = m.nets[0];
    const titleEl = document.getElementById('depTitle');
    if(titleEl) titleEl.textContent = 'Select Network';
    body.innerHTML = depStep3HTML();
    setDepCont(true);
    return;
  }
  if(depStep === 4){
    const titleEl = document.getElementById('depTitle');
    if(titleEl) titleEl.textContent = 'Deposit Address';
    body.innerHTML = depStep4HTML();
    setDepCont(true, 'Continue to Upload Proof');
    return;
  }
  if(depStep === 5){
    const titleEl = document.getElementById('depTitle');
    if(titleEl) titleEl.textContent = 'Upload Payment Proof';
    body.innerHTML = depStep5HTML();
    depProofFile = null;
    setDepCont(false, 'Submit Deposit');
    return;
  }
}

function depGoBack(){
  if(depStep > 1){ depStep--; renderDepStep(); }
  else { closeDepositSheet(); }
}

function depStep1HTML(){
  const stepBar = makeStepBar(5, 1, 'dep');
  return stepBar + CRYPTO_METHODS.map((m,i)=>`
  <div class="method-card${i===depMethodIdx?' sel':''}" onclick="depMethodIdx=${i};document.querySelectorAll('.method-card').forEach(c=>c.classList.remove('sel'));this.classList.add('sel');setDepCont(true)">
    <div class="method-ico" style="background:${m.bg}"><i class="${m.icon}" style="color:${m.color}"></i></div>
    <div class="method-info"><div class="method-nm">${m.name}</div><div class="method-sub">${m.sym} Â· Min: ${m.min} ${m.sym}</div></div>
    ${m.badge?`<span class="method-badge" style="background:rgba(74,108,247,.1);color:var(--blue2);border:1px solid rgba(74,108,247,.2)">${m.badge}</span>`:''}
    <i class="fa-solid fa-chevron-right method-arrow"></i>
  </div>`).join('');
}

function depStep2HTML(){
  const m = CRYPTO_METHODS[depMethodIdx];
  const stepBar = makeStepBar(5, 2, 'dep');
  return stepBar + `
  <div style="display:flex;align-items:center;gap:12px;padding:13px 14px;background:var(--c1);border:1px solid var(--bd);border-radius:12px;margin-bottom:16px">
    <div style="width:40px;height:40px;border-radius:11px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0">
      <i class="${m.icon}" style="color:${m.color}"></i>
    </div>
    <div><div style="font-weight:500;font-size:.9rem">${m.name}</div><div style="font-size:.72rem;color:#444;margin-top:1px">${m.sym}</div></div>
  </div>
  <div class="amt-box">
    <div class="amt-top">
      <span class="amt-lbl">Amount (USD)</span>
      <span class="amt-bal">Min: <span>$10.00</span></span>
    </div>
    <div class="amt-row">
      <span class="amt-cur">$</span>
      <input class="amt-inp" type="number" id="depAmtInp" placeholder="0.00" min="10" value="${depAmt||''}"
        oninput="depAmt=parseFloat(this.value)||0;setDepCont(depAmt>=10)"/>
      <span class="amt-sym">USD</span>
    </div>
    <div class="quick-btns">
      <div class="q-btn" onclick="setDepAmt(50)">$50</div>
      <div class="q-btn" onclick="setDepAmt(100)">$100</div>
      <div class="q-btn" onclick="setDepAmt(250)">$250</div>
      <div class="q-btn" onclick="setDepAmt(500)">$500</div>
      <div class="q-btn" onclick="setDepAmt(1000)">$1K</div>
    </div>
    <div class="amt-note">Minimum deposit: $10.00 Â· No deposit fee</div>
  </div>`;
}

function depStep3HTML(){
  const m = CRYPTO_METHODS[depMethodIdx];
  const stepBar = makeStepBar(5, 3, 'dep');
  const fees = {'TRC-20 (Tron)':'~$1.00','ERC-20 (Ethereum)':'~$5-15','BEP-20 (BSC)':'~$0.50','Solana (SPL)':'~$0.01','BTC (Native SegWit)':'~$2-5','BTC (Legacy)':'~$3-8','Polygon':'~$0.01','XRP Ledger':'~$0.01','Litecoin (LTC)':'~$0.10'};
  const netHtml = m.nets.map(n => {
    const sel = n === depNetwork;
    return `<div class="net-item${sel?' sel':''}" onclick="depNetwork='${n.replace(/'/g,"\\'")}';document.querySelectorAll('#depBody .net-item').forEach(x=>{x.classList.remove('sel');x.querySelector('.net-chk').style.opacity='0';});this.classList.add('sel');this.querySelector('.net-chk').style.opacity='1';setDepCont(true)">
      <div><div class="net-nm">${n}</div><div class="net-info">Fee: ${fees[n]||'~$1.00'} Â· 2â€“5 min</div></div>
      <i class="fa-solid fa-circle-check net-chk" style="opacity:${sel?1:0}"></i>
    </div>`;
  }).join('');
  return stepBar + `<div class="net-list">${netHtml}</div>`;
}

function depStep4HTML(){
  const m = CRYPTO_METHODS[depMethodIdx];
  const addr = m.addr;
  const net = depNetwork || m.nets[0];
  const coinUri = m.sym === 'BTC' ? 'bitcoin:'+addr : m.sym === 'ETH' ? 'ethereum:'+addr : m.sym === 'XRP' ? 'xrpl:'+addr : m.sym === 'LTC' ? 'litecoin:'+addr : m.sym === 'SOL' ? 'solana:'+addr : addr;
  const qr = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(coinUri)}&bgcolor=ffffff&color=000000&margin=6&ecc=M`;
  const stepBar = makeStepBar(5, 4, 'dep');
  return stepBar + `
  <div class="addr-box">
    <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px">
      <div style="width:42px;height:42px;border-radius:12px;background:${m.bg};display:flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0">
        <i class="${m.icon}" style="color:${m.color}"></i>
      </div>
      <div>
        <div style="font-weight:500;font-size:.9rem">${m.name}</div>
        <div class="net-badge" style="margin:3px 0 0"><i class="fa-solid fa-circle" style="font-size:.3rem"></i>${net}</div>
      </div>
    </div>
    <div class="addr-warn">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <div class="addr-warn-txt">Only send <strong>${m.sym}</strong> on <strong>${net}</strong>. Sending the wrong asset will result in permanent loss.</div>
    </div>
    <div class="addr-lbl">${m.sym} Deposit Address</div>
    <div class="addr-field">
      <div class="addr-txt">${addr}</div>
      <button class="copy-btn" onclick="copyTxt('${addr}')"><i class="fa-regular fa-copy"></i> Copy</button>
    </div>
    <div class="qr-row">
      <div class="qr-box"><img src="${qr}" alt="QR Code" loading="lazy"/></div>
      <div style="font-size:.7rem;color:#333">Scan to get address</div>
    </div>
    <div class="addr-min"><i class="fa-solid fa-circle-info" style="opacity:.3"></i>Min: ${m.min} ${m.sym} Â· Confirmations required: 2</div>
  </div>
  <div class="cf-box">
    <div class="cf-row"><span class="cf-lbl">Coin</span><span class="cf-val">${m.name} (${m.sym})</span></div>
    <div class="cf-row"><span class="cf-lbl">Network</span><span class="cf-val">${net}</span></div>
    <div class="cf-row"><span class="cf-lbl">Amount</span><span class="cf-val g">$${(depAmt||0).toFixed(2)}</span></div>
    <div class="cf-row"><span class="cf-lbl">Address</span><span class="cf-val mono">${addr.slice(0,12)}...${addr.slice(-8)}</span></div>
    <div class="cf-row"><span class="cf-lbl">Est. Arrival</span><span class="cf-val g">2â€“5 minutes</span></div>
    <div class="cf-row"><span class="cf-lbl">Deposit Fee</span><span class="cf-val g">Free</span></div>
  </div>`;
}

function depStep5HTML(){
  const m = CRYPTO_METHODS[depMethodIdx];
  const net = depNetwork || m.nets[0];
  const stepBar = makeStepBar(5, 5, 'dep');
  return stepBar + `
  <div style="text-align:center;margin-bottom:18px">
    <div style="width:56px;height:56px;border-radius:50%;background:rgba(74,108,247,.1);border:2px solid rgba(74,108,247,.2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:1.4rem;color:var(--blue2)">
      <i class="fa-solid fa-camera"></i>
    </div>
    <div style="font-weight:600;font-size:.95rem;margin-bottom:6px">Upload Payment Proof</div>
    <div style="font-size:.78rem;color:#555;line-height:1.6">Take a screenshot of your transaction receipt or wallet confirmation and upload it below. This helps us verify and approve your deposit faster.</div>
  </div>
  <form id="proofUploadForm" enctype="multipart/form-data">
    <input type="hidden" name="coin" value="${m.sym}"/>
    <input type="hidden" name="network" value="${net}"/>
    <input type="hidden" name="amount" value="${depAmt}"/>
    <div id="proofDropZone" onclick="document.getElementById('proofFileInput').click()"
         style="border:2px dashed #2a2a2a;border-radius:14px;padding:28px 16px;text-align:center;cursor:pointer;transition:border-color .2s;margin-bottom:14px"
         ondragover="event.preventDefault();this.style.borderColor='var(--blue2)'"
         ondragleave="this.style.borderColor='#2a2a2a'"
         ondrop="handleProofDrop(event)">
      <div id="proofPreview" style="display:none;margin-bottom:12px">
        <img id="proofPreviewImg" src="" style="max-width:100%;max-height:200px;border-radius:10px;object-fit:contain"/>
      </div>
      <div id="proofPlaceholder">
        <i class="fa-solid fa-cloud-arrow-up" style="font-size:1.8rem;color:#2a2a2a;display:block;margin-bottom:10px"></i>
        <div style="font-size:.84rem;color:#444;margin-bottom:4px">Tap to select screenshot</div>
        <div style="font-size:.72rem;color:#2a2a2a">JPG, PNG or PDF Â· Max 5MB</div>
      </div>
      <input type="file" id="proofFileInput" name="proof" accept="image/*,.pdf" style="display:none" onchange="handleProofFile(this)"/>
    </div>
    <div style="background:rgba(0,212,154,.04);border:1px solid rgba(0,212,154,.12);border-radius:10px;padding:12px 14px;display:flex;gap:9px;margin-bottom:14px">
      <i class="fa-solid fa-circle-check" style="color:var(--acc);flex-shrink:0;margin-top:2px"></i>
      <div style="font-size:.75rem;color:#777;line-height:1.55">
        <strong style="color:#aaa">Your deposit details:</strong><br>
        ${m.sym} Â· ${net} Â· <strong style="color:var(--grn)">$${(depAmt||0).toFixed(2)}</strong>
      </div>
    </div>
  </form>`;
}

function handleProofFile(input){
  const file = input.files[0];
  if(!file) return;
  if(file.size > 5*1024*1024){ showToast('File too large (max 5MB)','red'); return; }
  const reader = new FileReader();
  reader.onload = (e) => {
    document.getElementById('proofPreviewImg').src = e.target.result;
    document.getElementById('proofPreview').style.display = 'block';
    document.getElementById('proofPlaceholder').style.display = 'none';
    document.getElementById('proofDropZone').style.borderColor = 'var(--blue2)';
    setDepCont(true, 'Submit Deposit');
    depProofFile = file;
  };
  reader.readAsDataURL(file);
}
function handleProofDrop(e){
  e.preventDefault();
  document.getElementById('proofDropZone').style.borderColor = '#2a2a2a';
  const file = e.dataTransfer.files[0];
  if(file){
    document.getElementById('proofFileInput').files = e.dataTransfer.files;
    handleProofFile(document.getElementById('proofFileInput'));
  }
}
function setDepAmt(v){depAmt=v;const el=document.getElementById('depAmtInp');if(el)el.value=v;setDepCont(v>=10);}

function depContinue(){
  if(depStep === 1){ if(depMethodIdx === null){ showToast('Select a payment method','red'); return; } depStep = 2; renderDepStep(); return; }
  if(depStep === 2){ if(depAmt < 10){ showToast('Minimum deposit is $10','red'); return; } depStep = 3; renderDepStep(); return; }
  if(depStep === 3){ depStep = 4; renderDepStep(); return; }
  if(depStep === 4){ depStep = 5; depProofFile = null; renderDepStep(); return; }
  if(depStep === 5){ submitDepositWithProof(); return; }
}

function submitDepositWithProof(){
  const m = CRYPTO_METHODS[depMethodIdx];
  const net = depNetwork || m.nets[0];
  const btn = document.getElementById('depContBtn');
  btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Submitting...';
  btn.className = 'cont-btn off';
  const fd = new FormData();
  fd.append('amount', depAmt);
  fd.append('paymethd_method', m.name);
  fd.append('coin', m.sym);
  fd.append('network', net);
  if(depProofFile) fd.append('proof', depProofFile);
  fetch(window.SAVE_DEPOSIT_URL, { method:'POST', body: fd, headers:{ 'Accept':'text/html'}, redirect:'follow' })
    .then(r => {
      if(r.ok || r.status === 302){ showPaySuccess(); }
      else { showToast('Deposit failed (HTTP '+r.status+')','red'); btn.innerHTML='<i class="fa-solid fa-arrow-right"></i> Submit Deposit'; btn.className='cont-btn on'; }
    })
    .catch(() => { showPaySuccess(); });
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   WITHDRAW
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
let wdStep=1, wdToken=null, wdAmt=0, wdAddr='';

function setWdCont(on,lbl='Continue'){const b=document.getElementById('wdContBtn');if(!b)return;b.className='cont-btn '+(on?'on':'off');b.innerHTML=`<i class="fa-solid fa-arrow-right"></i> ${lbl}`;}

function renderWdStep(){
  const titleEl = document.getElementById('wdTitle');
  const backLbl = document.getElementById('wdBackLbl');
  if(titleEl) titleEl.textContent='Withdraw Funds';
  if(backLbl) backLbl.textContent=wdStep===1?'Close':'Back';
  const body = document.getElementById('wdBody');
  if(body) body.innerHTML=wdHTML();
}
function wdHTML(){
  const stepBar=makeStepBar(3,wdStep,'wd');
  let html=stepBar;
  const tkBtn=wdToken?`<button class="token-sel-btn filled" onclick="openTokenPicker('wd')"><div style="display:flex;align-items:center;gap:12px"><div class="tp-opt-ico" style="background:${TOKENS[wdToken]?.bg||'#1a1a1a'};width:36px;height:36px"><i class="${TOKENS[wdToken]?.icon||'fa-solid fa-coins'}" style="color:${TOKENS[wdToken]?.color||'#888'}"></i></div><div><div style="font-weight:500;font-size:.92rem">${TOKENS[wdToken]?.name||wdToken}</div><div style="color:#444;font-size:.72rem">${wdToken}</div></div></div><i class="fa-solid fa-chevron-down" style="color:#333;font-size:.65rem"></i></button>`:
    `<button class="token-sel-btn" onclick="openTokenPicker('wd')"><span style="color:#2a2a2a;font-size:.9rem">Select asset to withdraw</span><i class="fa-solid fa-chevron-down" style="color:#2a2a2a;font-size:.65rem"></i></button>`;
  html+=`<div style="margin-bottom:18px"><div style="font-size:.7rem;color:#333;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px">1. Select asset &amp; amount</div>
  ${tkBtn}
  ${wdToken?`<div class="amt-box" style="margin-top:12px"><div class="amt-top"><span class="amt-lbl">Amount</span><span class="amt-bal">Balance: <span>$0.00</span></span></div>
  <div class="amt-row"><span class="amt-cur">$</span><input class="amt-inp" type="number" id="wdAmtInp" placeholder="0.00" min="10" value="${wdAmt||''}" oninput="wdAmt=parseFloat(this.value)||0;setWdCont(wdAmt>=10&&!!wdAddr)"/><span class="amt-sym">${wdToken}</span></div>
  <div class="quick-btns"><div class="q-btn" onclick="setWdAmt(50)">$50</div><div class="q-btn" onclick="setWdAmt(100)">$100</div><div class="q-btn" onclick="setWdAmt(250)">$250</div><div class="q-btn" onclick="setWdAmt(500)">$500</div></div>
  <div class="amt-note">Minimum withdrawal: $10.00</div></div>`:''}
  </div>`;
  if(wdStep>=2&&wdToken){
    html+=`<div style="margin-bottom:18px"><div style="font-size:.7rem;color:#333;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px">2. Destination address</div>
    <div class="form-group"><label class="form-lbl">Wallet Address / IBAN</label><input class="form-inp" type="text" id="wdAddrInp" placeholder="Enter wallet address or bank IBAN..." value="${wdAddr}" oninput="wdAddr=this.value.trim();setWdCont(wdAmt>=10&&wdAddr.length>5)"/></div>
    <div class="form-group"><label class="form-lbl">Withdrawal Method</label>
    <select class="form-inp"><option>Crypto Wallet</option><option>Bank Wire Transfer</option><option>SEPA Transfer</option></select></div>
    <div style="background:rgba(255,69,96,.04);border:1px solid rgba(255,69,96,.12);border-radius:10px;padding:11px 13px;display:flex;gap:9px"><i class="fa-solid fa-triangle-exclamation" style="color:var(--red);font-size:.8rem;flex-shrink:0;margin-top:2px"></i><div style="font-size:.74rem;color:#666;line-height:1.55">Double-check your destination address. Withdrawals to wrong addresses cannot be recovered.</div></div>
    </div>`;
  }
  if(wdStep>=3){
    html+=`<div><div style="font-size:.7rem;color:#333;text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px">3. Review &amp; confirm</div>
    <div class="cf-box">
      <div class="cf-row"><span class="cf-lbl">Asset</span><span class="cf-val">${TOKENS[wdToken]?.name||wdToken} (${wdToken})</span></div>
      <div class="cf-row"><span class="cf-lbl">Amount</span><span class="cf-val g">$${(wdAmt||0).toFixed(2)}</span></div>
      <div class="cf-row"><span class="cf-lbl">Network Fee</span><span class="cf-val">~$1.00</span></div>
      <div class="cf-row"><span class="cf-lbl">You Receive</span><span class="cf-val g">$${((wdAmt||0)-1).toFixed(2)}</span></div>
      <div class="cf-row"><span class="cf-lbl">Destination</span><span class="cf-val mono">${wdAddr.length>20?wdAddr.slice(0,12)+'...'+wdAddr.slice(-8):wdAddr}</span></div>
      <div class="cf-row"><span class="cf-lbl">Processing</span><span class="cf-val">2â€“5 minutes</span></div>
    </div>
    <div style="margin-top:13px;background:#0a0a0a;border:1px solid #161616;border-radius:11px;padding:13px;font-size:.74rem;color:#333;line-height:1.6;display:flex;gap:8px"><i class="fa-solid fa-lock" style="color:#2a2a2a;flex-shrink:0;margin-top:2px"></i>Withdrawal secured by 256-bit encryption. Processing time: 2â€“5 minutes after confirmation.</div>
    </div>`;
  }
  return html;
}
function setWdAmt(v){wdAmt=v;const el=document.getElementById('wdAmtInp');if(el)el.value=v;setWdCont(wdAmt>=10&&wdAddr.length>5);}
function wdGoBack(){
  if(wdStep>1){wdStep--;renderWdStep();}
  else closeWithdrawSheet();
}
function wdContinue(){
  if(!wdToken){showToast('Select an asset first','red');return;}
  if(wdAmt<10){showToast('Minimum withdrawal is $10','red');return;}
  if(wdStep===2&&wdAddr.length<5){showToast('Enter a valid destination address','red');return;}
  if(wdStep===3){showPaySuccess();return;}
  wdStep++;renderWdStep();
  if(wdStep===2)setWdCont(wdAmt>=10&&wdAddr.length>5,'Review Withdrawal');
  if(wdStep===3)setWdCont(true,'Confirm Withdrawal');
}

/* â•â• TOKEN PICKER â•â• */
let tpFor=null;
function openTokenPicker(forSheet){
  tpFor=forSheet;
  const cur=forSheet==='dep'?null:wdToken;
  const listEl=document.getElementById('tpList');
  if(!listEl) return;
  listEl.innerHTML=Object.entries(TOKENS).map(([sym,t])=>`
    <div class="tp-opt${sym===cur?' sel':''}" onclick="pickToken('${sym}')" data-nm="${t.name}" data-sym="${sym}">
      <div class="tp-opt-ico" style="background:${t.bg}"><i class="${t.icon}" style="color:${t.color}"></i></div>
      <div class="tp-opt-info"><div class="tp-opt-nm">${t.name}</div><div class="tp-opt-sym">${sym}</div></div>
      <div style="font-size:.7rem;color:#333">Min: ${t.min} ${sym}</div>
      <i class="fa-solid fa-check tp-opt-chk" style="${sym===cur?'opacity:1':''}; margin-left:8px"></i>
    </div>`).join('');
  document.getElementById('tokenPicker').classList.add('open');
  document.getElementById('tpBg').classList.add('open');
}
function closeTokenPicker(){
  const tp = document.getElementById('tokenPicker');
  const tpBg = document.getElementById('tpBg');
  if(tp) tp.classList.remove('open');
  if(tpBg) tpBg.classList.remove('open');
}
function pickToken(sym){
  closeTokenPicker();
  if(tpFor==='wd'){wdToken=sym;renderWdStep();setWdCont(false);}
}
function filterTokenPicker(q){document.querySelectorAll('.tp-opt').forEach(o=>{const nm=o.dataset.nm.toLowerCase(),s=o.dataset.sym.toLowerCase();o.style.display=(!q||nm.includes(q.toLowerCase())||s.includes(q.toLowerCase()))?'':'none';});}

/* â•â• STEP BAR â•â• */
function makeStepBar(total,cur,prefix){
  let html='<div class="step-bar" style="margin-bottom:20px">';
  for(let i=1;i<=total;i++){
    const cls=i<cur?'done':i===cur?'active':'idle';
    const inner=i<cur?'<i class="fa-solid fa-check" style="font-size:.65rem"></i>':i;
    html+=`<div class="s-dot ${cls}">${inner}</div>`;
    if(i<total)html+=`<div class="s-line${i<cur?' done':''}"></div>`;
  }
  return html+'</div>';
}

