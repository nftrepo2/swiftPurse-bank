        <div>
            <div class="inner-title">Apply for a Card</div>
            <p style="font-size:.78rem;color:#555;margin-top:2px;">Choose a card type and fill in your details</p>
        </div>
    </div>

    
            <div x-data="{
            selectedType: null,
            isPhysical: false,
            selectCard(id, type, fee, name) {
                this.selectedType = id;
                this.isPhysical   = (type === 'physical');
            }
        }">
            
            <p style="font-size:.68rem;font-weight:500;color:#444;text-transform:uppercase;letter-spacing:.07em;margin-bottom:12px;">Select a Card Type</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[9px] mb-6">
                                <div @click="selectCard(1, 'virtual', 0.00, 'Virtual Visa')"
                     :class="selectedType === 1 ? 'ring-2 ring-[#4a6cf7] border-[#4a6cf7]' : 'border-[#1e1e1e] hover:border-[#333]'"
                     style="background:linear-gradient(135deg,#0f1726 0%,#1a2040 100%);border-radius:13px;padding:18px;cursor:pointer;transition:all .2s;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                        <div>
                            <p style="font-size:.9rem;font-weight:600;color:#fff;">Virtual Visa</p>
                            <p style="font-size:.72rem;color:#6b7280;margin-top:2px;">Visa · Virtual</p>
                        </div>
                        <span style="font-size:.72rem;font-weight:600;color:#6e8efb;background:rgba(74,108,247,.12);padding:3px 10px;border-radius:20px;">
                             Free                         </span>
                    </div>
                                            <p style="font-size:.78rem;color:#4b5563;">Instant virtual Visa card for online payments. Card details delivered immediately upon approval.</p>
                                                        </div>
                                <div @click="selectCard(2, 'virtual', 0.00, 'Virtual Mastercard')"
                     :class="selectedType === 2 ? 'ring-2 ring-[#4a6cf7] border-[#4a6cf7]' : 'border-[#1e1e1e] hover:border-[#333]'"
                     style="background:linear-gradient(135deg,#0f1726 0%,#1a2040 100%);border-radius:13px;padding:18px;cursor:pointer;transition:all .2s;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                        <div>
                            <p style="font-size:.9rem;font-weight:600;color:#fff;">Virtual Mastercard</p>
                            <p style="font-size:.72rem;color:#6b7280;margin-top:2px;">Mastercard · Virtual</p>
                        </div>
                        <span style="font-size:.72rem;font-weight:600;color:#6e8efb;background:rgba(74,108,247,.12);padding:3px 10px;border-radius:20px;">
                             Free                         </span>
                    </div>
                                            <p style="font-size:.78rem;color:#4b5563;">Instant virtual Mastercard for online and international transactions.</p>
                                                        </div>
                                <div @click="selectCard(3, 'physical', 15.00, 'Physical Visa')"
                     :class="selectedType === 3 ? 'ring-2 ring-[#4a6cf7] border-[#4a6cf7]' : 'border-[#1e1e1e] hover:border-[#333]'"
                     style="background:linear-gradient(135deg,#0f1726 0%,#1a2040 100%);border-radius:13px;padding:18px;cursor:pointer;transition:all .2s;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                        <div>
                            <p style="font-size:.9rem;font-weight:600;color:#fff;">Physical Visa</p>
                            <p style="font-size:.72rem;color:#6b7280;margin-top:2px;">Visa · Physical</p>
                        </div>
                        <span style="font-size:.72rem;font-weight:600;color:#6e8efb;background:rgba(74,108,247,.12);padding:3px 10px;border-radius:20px;">
                             $15.00 fee                         </span>
                    </div>
                                            <p style="font-size:.78rem;color:#4b5563;">Physical Visa debit card delivered to your address. \ issuance fee applies.</p>
                                                                <p style="font-size:.72rem;color:#6b7280;margin-top:8px;">
                            <svg style="width:11px;height:11px;display:inline;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                            Delivery: ~7 days
                        </p>
                                    </div>
                                <div @click="selectCard(4, 'physical', 15.00, 'Physical Mastercard')"
                     :class="selectedType === 4 ? 'ring-2 ring-[#4a6cf7] border-[#4a6cf7]' : 'border-[#1e1e1e] hover:border-[#333]'"
                     style="background:linear-gradient(135deg,#0f1726 0%,#1a2040 100%);border-radius:13px;padding:18px;cursor:pointer;transition:all .2s;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
                        <div>
                            <p style="font-size:.9rem;font-weight:600;color:#fff;">Physical Mastercard</p>
                            <p style="font-size:.72rem;color:#6b7280;margin-top:2px;">Mastercard · Physical</p>
                        </div>
                        <span style="font-size:.72rem;font-weight:600;color:#6e8efb;background:rgba(74,108,247,.12);padding:3px 10px;border-radius:20px;">
                             $15.00 fee                         </span>
                    </div>
                                            <p style="font-size:.78rem;color:#4b5563;">Physical Mastercard delivered worldwide. \ issuance fee applies.</p>
                                                                <p style="font-size:.72rem;color:#6b7280;margin-top:8px;">
                            <svg style="width:11px;height:11px;display:inline;" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                            Delivery: ~10 days
                        </p>
                                    </div>
                            </div>

            
            <form action="/dashboard/cards" method="POST"
                  x-show="selectedType !== null"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 translate-y-2"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  style="display:none;">                <input type="hidden" name="card_type_id" :value="selectedType">

                <div class="bg-[#111] border border-[#1e1e1e] rounded-[13px] p-5 space-y-4">
                    <p style="font-size:.68rem;font-weight:500;color:#444;text-transform:uppercase;letter-spacing:.07em;">Card Details</p>

                    <div>
                        <label style="font-size:.78rem;color:#6b7280;display:block;margin-bottom:6px;">Card Holder Name</label>
                        <input type="text" name="card_holder" class="card-inp"
                               value="Pmarcel Limited "
                               placeholder="JOHN DOE" required>
                    </div>

                    
                    <div x-show="isPhysical" x-transition class="space-y-3">
                        <p style="font-size:.78rem;color:#6b7280;">Shipping Address</p>
                        <input type="text" name="shipping_address[line1]" class="card-inp"
                               value=""
                               placeholder="Street address" :required="isPhysical">
                        <div class="grid grid-cols-2 gap-3">
                            <input type="text" name="shipping_address[city]" class="card-inp"
                                   value=""
                                   placeholder="City" :required="isPhysical">
                            <input type="text" name="shipping_address[postcode]" class="card-inp"
                                   value=""
                                   placeholder="Postcode" :required="isPhysical">
                        </div>
                        <input type="text" name="shipping_address[country]" class="card-inp"
                               value="Nigeria"
                               placeholder="Country" :required="isPhysical">
                    </div>

                    <button type="submit"
                            style="width:100%;padding:12px;border-radius:10px;background:#4a6cf7;color:#fff;font-size:.85rem;font-weight:600;border:none;cursor:pointer;"
                            onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
                        Submit Application
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="toast"></div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     DEPOSIT BOTTOM SHEET â€” CRYPTO ONLY
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="sheet-bg" id="depSheetBg" onclick="handleDepBgClick(event)">
<div class="sheet" id="depSheet">
  <div class="sheet-handle"><div class="sheet-handle-bar"></div></div>
  <div class="sheet-hdr">
    <button class="sheet-back" onclick="depGoBack()"><i class="fa-solid fa-chevron-left"></i> <span id="depBackLbl">Close</span></button>
    <span class="sheet-title" id="depTitle">Deposit Crypto</span>
    <button class="sheet-close-btn" onclick="closeDepositSheet()"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="sheet-body" id="depBody"></div>
  <div class="cont-bar"><button class="cont-btn off" id="depContBtn" onclick="depContinue()"><i class="fa-solid fa-arrow-right"></i> Continue</button></div>
</div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     WITHDRAW BOTTOM SHEET
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="sheet-bg" id="wdSheetBg" onclick="handleWdBgClick(event)">
<div class="sheet" id="wdSheet">
  <div class="sheet-handle"><div class="sheet-handle-bar"></div></div>
  <div class="sheet-hdr">
    <button class="sheet-back" onclick="wdGoBack()"><i class="fa-solid fa-chevron-left"></i> <span id="wdBackLbl">Back</span></button>
    <span class="sheet-title" id="wdTitle">Withdraw</span>
    <button class="sheet-close-btn" onclick="closeWithdrawSheet()"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <div class="sheet-body" id="wdBody"></div>
  <div class="cont-bar"><button class="cont-btn off" id="wdContBtn" onclick="wdContinue()"><i class="fa-solid fa-arrow-right"></i> Continue</button></div>
</div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     TOKEN PICKER
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="token-picker-bg" id="tpBg" onclick="closeTokenPicker()"></div>
<div class="token-picker" id="tokenPicker">
  <div class="px-4 pt-4 pb-3 border-b border-[#111] flex-shrink-0">
    <div class="flex items-center justify-between mb-3">
      <span class="font-medium text-[.9rem]">Select token</span>
      <button class="w-8 h-8 rounded-full bg-[#1a1a1a] border-none text-[#888] text-[.8rem] flex items-center justify-center cursor-pointer" onclick="closeTokenPicker()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="flex items-center gap-2 bg-[#111] border border-[#1e1e1e] rounded-[10px] px-3 py-2">
      <i class="fa-solid fa-magnifying-glass text-[#333] text-[.8rem]"></i>
      <input class="flex-1 bg-transparent border-none outline-none text-[.85rem] text-white placeholder-[#333]" type="text" placeholder="Search..." oninput="filterTokenPicker(this.value)"/>
    </div>
  </div>
  <div class="tp-list" id="tpList"></div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     PAYMENT SUCCESS OVERLAY
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="pay-success-bg" id="paySuccessBg">
  <div class="bg-[#0d0d0d] border border-[#1e1e1e] rounded-[20px] p-[28px] mx-4 text-center max-w-[340px] w-full">
    <div class="w-[72px] h-[72px] rounded-full bg-grn/10 border-2 border-grn/30 flex items-center justify-center mx-auto mb-4 text-[1.8rem] text-grn"><i class="fa-solid fa-check"></i></div>
    <div class="font-sora font-bold text-[1.15rem] mb-2">Payment Successful!</div>
    <div class="text-[.82rem] text-[#666] mb-3">Your deposit has been received and is being processed.</div>
    <div class="flex items-center justify-center gap-2 bg-[#111] border border-[#1e1e1e] rounded-[10px] px-3 py-[10px] mb-4 text-[.76rem] text-[#777]"><i class="fa-solid fa-clock text-ylw"></i>Â Please hold forÂ <span class="text-white font-medium" id="payHoldTime">30 minutes â€“ 24 hours</span></div>
    <div class="text-[.74rem] text-[#444] mb-5 leading-[1.6]">Your funds will reflect in your account once the network confirms your transaction. You will be notified.</div>
    <button class="w-full py-[13px] rounded-[12px] border-none bg-grn text-black font-semibold text-[.9rem] cursor-pointer" onclick="closePaySuccess()"><i class="fa-solid fa-check mr-[6px]"></i>Got it, thanks!</button>
  </div>
</div>

<!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     COPY TRADE WALLET MODAL
â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
<div class="ct-wallet-modal-bg" id="ctWalletBg" onclick="closeCopyTradeWallet(event)">
  <div class="ct-wallet-modal">
    <div class="font-sora font-bold text-[1.05rem] mb-1">Copy Trade Wallet</div>
