        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Log Out
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div id="mainWrapper" class="main-wrapper flex-1 flex flex-col min-h-screen full">
    <header class="bg-white sticky top-0 z-30 border-b border-gray-100">
      <div class="flex items-center justify-between px-4 py-3">
        <div class="flex items-center gap-3">
          <button onclick="toggleSidebar()" class="p-1.5 rounded-lg hover:bg-gray-100">
            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <img src="https://swiftpursebank.com/wp-api/site/t_564238e3795f75706dc155a65d045103.svg" alt="SwiftPurse" class="h-8">
        </div>
        <div class="flex items-center gap-3 relative">
          <a href="notifications.html" class="p-1.5 rounded-full hover:bg-gray-100">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          </a>
          <button onclick="toggleProfile()" class="focus:outline-none">
            <img id="headerAvatar" src="https://swiftpursebank.com/wp-user/uploads/pic_5d4333b123ce5455c301f5a86f394544.png" alt="User" class="w-9 h-9 rounded-full object-cover border border-gray-200">
          </button>
          <div id="profileMenu" class="hidden absolute right-0 top-12 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-2 z-50">
            <div class="px-4 py-2 border-b border-gray-100 flex items-center gap-3">
              <img id="menuAvatar" src="https://swiftpursebank.com/wp-user/uploads/pic_5d4333b123ce5455c301f5a86f394544.png" class="w-8 h-8 rounded-full">
              <div>
                <div class="text-sm font-medium text-gray-900 userDisplayName">User</div>
                <div class="text-xs text-gray-500 userTier">Tier 1</div>
              </div>
            </div>
            <a href="dashboard.html" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Home</a>
            <a href="settings.html" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Settings</a>
            <a href="#" data-auth-logout class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Logout</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 p-4 md:p-6 max-w-2xl mx-auto w-full">
      <!-- Page content host (empty template) -->
      <div id="pageContent"></div>
    </main>

    <footer class="text-center text-xs text-gray-500 py-6">
      Copyright © 2026. All rights reserved.
    </footer>
  </div>

  <script>
    function openSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.remove('closed');
      mw.classList.remove('full');
      if (window.innerWidth < 768) {
        ov.classList.remove('hidden');
        requestAnimationFrame(() => ov.classList.remove('opacity-0'));
      }
    }
    function closeSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.add('closed');
      mw.classList.add('full');
      ov.classList.add('opacity-0');
      setTimeout(() => ov.classList.add('hidden'), 300);
    }
    function toggleSidebar() {
      const sn = document.getElementById('sidenav');
      if (sn.classList.contains('closed')) openSidebar();
      else closeSidebar();
    }
    function toggleProfile() {
      document.getElementById('profileMenu').classList.toggle('hidden');
    }
    document.getElementById('overlay').addEventListener('click', closeSidebar);
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileMenu');
      if (!menu) return;
      const btn = e.target.closest('button[onclick="toggleProfile()"]');
      if (!menu.contains(e.target) && !btn) menu.classList.add('hidden');
    });
    if (window.innerWidth < 768) {
      document.getElementById('sidenav').classList.add('closed');
      document.getElementById('mainWrapper').classList.add('full');
    }
  </script>
  <script src="../js/config.js"></script>
  <script src="../js/auth.js"></script>
  <script>
  async function loadPageShell() {
    try {
      var me = null;
      try {
        var meRes = await api.get('/auth/me');
        me = meRes.data;
        if (me && me.user) me = me.user;
      } catch (_) {}
      if (me) {
        var name = me.name || [me.first_name, me.last_name].filter(Boolean).join(' ') || 'User';
        document.querySelectorAll('.userDisplayName').forEach(function (el) { el.textContent = name; });
        document.querySelectorAll('.userTier').forEach(function (el) { el.textContent = me.account_tier || 'Tier 1'; });
        if (me.image) {
          var a1 = document.getElementById('headerAvatar');
          var a2 = document.getElementById('menuAvatar');
          if (a1) a1.src = me.image;
          if (a2) a2.src = me.image;
        }
      }
    } catch (e) {
      console.error(e);
    }
  }
  document.addEventListener('DOMContentLoaded', loadPageShell);
</script>
</body>
</html>

