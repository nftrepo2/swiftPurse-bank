/* â•â• LIVE PRICE FLICKER â•â• */
const mP=[],mR=[];
function flickerPrices(){
  if(mP.length===0){
    for(let i=0;i<32;i++){
      const el=document.getElementById('mp-'+i)||document.getElementById('mmp-'+i);
      if(!el)break;
      const v=parseFloat((el.textContent||'').replace(/[^0-9.\-]/g,''))||0;
      mP.push(v); mR.push(Math.max(v*0.001,0.01));
    }
    if(mP.length===0)return;
  }
  mP.forEach((p,i)=>{
    mP[i]+=(Math.random()-.5)*mR[i]*.3;
    const v=mP[i];
    const f='$'+v.toLocaleString('en-US',{minimumFractionDigits:v>=1?2:4,maximumFractionDigits:v>=1?2:4});
    ['mp-','mmp-'].forEach(pfx=>{const el=document.getElementById(pfx+i);if(el){el.textContent=f;el.classList.add('pf');setTimeout(()=>el.classList.remove('pf'),250);}});
  });
}
setInterval(flickerPrices,2800);

/* â•â• ORDER CALC â•â• */
function calcOrder(){const a=parseFloat(document.getElementById('tradeAmt')?.value)||0,l=parseFloat(document.getElementById('leverageSel')?.value||1);const of=document.getElementById('orderFee');const ot=document.getElementById('orderTotal');if(of)of.textContent=CURR_SYM+(a*.001).toFixed(2);if(ot)ot.textContent=CURR_SYM+(a*l).toFixed(2);}

