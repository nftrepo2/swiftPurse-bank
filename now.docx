          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-white shadow">
            <img src="/wp-user/i/img3.svg" >
          </div>
          <span class="text-xs text-gray-600">Loan</span>
        </a>
        <a href="add-funds.html" class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-white shadow">
            <img src="/wp-user/i/img4.svg" >
          </div>
          <span class="text-xs text-gray-600">Topup</span>
        </a>
      </div>

      <!-- Credit / Debit cards -->
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="bg-white rounded-2xl p-4 shadow-sm flex justify-between items-center">
          <div>
            <div class="text-xs text-gray-500 mb-1">Total Credit</div>
            <div class="text-lg font-semibold text-green-600">+<span id="totalCredit">$0.00</span></div>
          </div>
          <img src="/wp-user/i/c2.svg" alt="" class="h-8 opacity-80">
        </div>
        <div class="bg-white rounded-2xl p-4 shadow-sm flex justify-between items-center">
          <div>
            <div class="text-xs text-gray-500 mb-1">Total Debit</div>
            <div class="text-lg font-semibold text-red-500">-<span id="totalDebit">$0.00</span></div>
          </div>
          <img src="/wp-user/i/d.svg" alt="" class="h-8 opacity-80">
        </div>
      </div>

      <!-- Recent Transactions -->
      <div class="bg-white rounded-2xl p-4 shadow-sm">
        <div class="flex justify-between items-center mb-4">
          <h2 class="font-semibold text-gray-800">Recent Transactions</h2>
          <a href="statements.html" class="text-gray-400 text-lg leading-none" title="View all">•••</a>
        </div>
        <div id="txList" class="space-y-3">
          <div class="text-sm text-gray-500 p-3 text-center">Loading transactions…</div>
        </div>
      </div>
    </main>

    <footer class="text-center text-xs text-gray-500 py-6">
      Copyright © 2026. All rights reserved.
    </footer>
  </div>

  <script>
    function openSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.remove('closed');
      mw.classList.remove('full');
      // Only show overlay on mobile
      if (window.innerWidth < 768) {
        ov.classList.remove('hidden');
        requestAnimationFrame(() => ov.classList.remove('opacity-0'));
      }
    }
    function closeSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.add('closed');
      mw.classList.add('full');
      ov.classList.add('opacity-0');
      setTimeout(() => ov.classList.add('hidden'), 300);
    }
    function toggleSidebar() {
      const sn = document.getElementById('sidenav');
      if (sn.classList.contains('closed')) openSidebar();
      else closeSidebar();
    }
    function toggleProfile() {
      document.getElementById('profileMenu').classList.toggle('hidden');
    }
    // Close sidebar when clicking the overlay (mobile)
    document.getElementById('overlay').addEventListener('click', closeSidebar);

    // Close profile dropdown when clicking outside
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileMenu');
      if (!menu) return;
      const btn = e.target.closest('button[onclick="toggleProfile()"]');
      if (!menu.contains(e.target) && !btn) menu.classList.add('hidden');
    });

    // On mobile, force sidebar closed on page load so state is consistent
    if (window.innerWidth < 768) {
      document.getElementById('sidenav').classList.add('closed');
      document.getElementById('mainWrapper').classList.add('full');
    }
  </script>
  <script type="text/javascript">
