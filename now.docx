      <!-- Quick Actions -->
      <div class="grid grid-cols-4 gap-3 mb-6">
        <a href="#" class="flex flex-col items-center gap-2">
          <div class="w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-white shadow">
