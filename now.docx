    <main class="flex-1 p-4 md:p-6 max-w-lg mx-auto w-full">
      <h1 class="text-xl font-semibold text-gray-800 mb-6">Send</h1>

      <form method="post" action="/wp-user/dashboard/send?index" class="bg-white rounded-2xl shadow-sm p-5 mb-6">
        <input type="hidden" name="newtrs" value="newtrs">

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Bank*</label>
          <input type="text" name="bank" placeholder="Enter Bank" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
        </div>

        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Swift Code *</label>
            <input type="text" name="swift" placeholder="Enter Swift Code" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Currency *</label>
            <input type="text" name="currency" placeholder="Enter Currency" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Routing Number *</label>
            <input type="text" name="routing" placeholder="Enter Routing Number" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Country *</label>
            <input type="text" name="country" placeholder="Enter Country" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
          </div>
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Account Number *</label>
          <input type="text" name="act_no" placeholder="Enter Account Number" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Account Holder Name *</label>
          <input type="text" name="act_hold_name" placeholder="Enter Account Holder Name" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
        </div>

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Amount *</label>
          <div class="relative">
            <input type="text" name="amount" placeholder="Enter Amount" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 pr-16 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300">
            <button type="button" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white text-xs font-medium text-gray-700 px-3 py-1.5 rounded-full shadow-sm border border-gray-200">Max</button>
          </div>
        </div>

        <div class="mb-5">
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Note *</label>
          <textarea name="note" rows="3" placeholder="Enter Note" class="w-full bg-gray-100 border-0 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-slate-300 resize-none"></textarea>
        </div>

        <button type="submit" class="w-full bg-slate-900 text-white py-3.5 rounded-xl font-medium text-sm hover:bg-slate-800 transition">Submit Transfer</button>
      </form>

      <!-- Recent transfer card -->
      <div class="bg-white rounded-2xl shadow-sm p-4 flex items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between text-sm">
            <div>
              <div class="text-xs text-gray-500">Amount</div>
              <div class="font-medium text-gray-900">$1,000.00</div>
            </div>
            <div>
              <div class="text-xs text-gray-500">Type</div>
              <div class="font-medium text-gray-900">Bank Transfer</div>
            </div>
            <div>
              <div class="text-xs text-gray-500">Date</div>
              <div class="font-medium text-gray-900">18/09/2026</div>
            </div>
          </div>
        </div>
        <span class="text-xs font-medium text-yellow-700 bg-yellow-100 px-2.5 py-1 rounded-full shrink-0">pending</span>
      </div>
    </main>

    <footer class="text-center text-xs text-gray-500 py-6">
      Copyright © 2026. All rights reserved.
    </footer>
  </div>

  <script>
    function openSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.remove('closed');
      mw.classList.remove('full');
      if (window.innerWidth < 768) {
        ov.classList.remove('hidden');
        requestAnimationFrame(() => ov.classList.remove('opacity-0'));
      }
    }
    function closeSidebar() {
      const sn = document.getElementById('sidenav');
      const mw = document.getElementById('mainWrapper');
      const ov = document.getElementById('overlay');
      sn.classList.add('closed');
      mw.classList.add('full');
      ov.classList.add('opacity-0');
      setTimeout(() => ov.classList.add('hidden'), 300);
    }
    function toggleSidebar() {
      const sn = document.getElementById('sidenav');
      if (sn.classList.contains('closed')) openSidebar();
      else closeSidebar();
    }
    function toggleProfile() {
      document.getElementById('profileMenu').classList.toggle('hidden');
    }
    document.getElementById('overlay').addEventListener('click', closeSidebar);
    document.addEventListener('click', function(e) {
      const menu = document.getElementById('profileMenu');
      if (!menu) return;
      const btn = e.target.closest('button[onclick="toggleProfile()"]');
      if (!menu.contains(e.target) && !btn) menu.classList.add('hidden');
    });
    if (window.innerWidth < 768) {
      document.getElementById('sidenav').classList.add('closed');
      document.getElementById('mainWrapper').classList.add('full');
    }
  </script>
