<script src="../js/config.js"></script>
<script src="../js/auth.js"></script>
<script>
(function () {
  function money(n) {
    var v = Number(n || 0);
    return '$' + v.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function fmtDate(d) {
    try {
      return new Date(d).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
    } catch (e) { return ''; }
  }
  async function loadDashboard() {
    try {
      var res = await api.get('/user/dashboard');
      var data = res.data || {};
      var user = data.user || {};
      var name = user.name || [user.first_name, user.last_name].filter(Boolean).join(' ') || 'User';
      document.querySelectorAll('.userDisplayName').forEach(function (el) { el.textContent = name; });
      document.querySelectorAll('.userTier').forEach(function (el) { el.textContent = user.account_tier || 'Tier 1'; });

      var bal = document.getElementById('balAmount');
      if (bal) bal.textContent = money(user.balance);
      var an = document.getElementById('acctNo');
      if (an) an.textContent = user.account_no || '—';
      var tier = document.getElementById('acctTier');
      if (tier) tier.textContent = user.account_tier || 'Tier 1';

      // Profile images (header + dropdown)
      if (user.image) {
        var headerAvatar = document.getElementById('headerAvatar');
        var menuAvatar = document.getElementById('menuAvatar');
        if (headerAvatar) headerAvatar.src = user.image;
        if (menuAvatar) menuAvatar.src = user.image;
        document.querySelectorAll('img[alt="User"]').forEach(function (img) { img.src = user.image; });
      }

      var badge = document.getElementById('notifBadge');
      if (badge) {
        if (data.unreadCount > 0) {
          badge.textContent = data.unreadCount;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }

      // Totals from transactions
      var txs = Array.isArray(data.transactions) ? data.transactions : [];
      var creditSum = 0, debitSum = 0;
      txs.forEach(function (t) {
        var amt = Number(t.amount || 0);
        if (t.type === 'credit' || t.type === 'deposit') creditSum += amt;
        else debitSum += amt;
      });
      var tc = document.getElementById('totalCredit');
      var td = document.getElementById('totalDebit');
      if (tc) tc.textContent = money(creditSum);
      if (td) td.textContent = money(debitSum);

      // Render inside Recent Transactions (#txList)
      var list = document.getElementById('txList');
      if (list) {
        if (!txs.length) {
          list.innerHTML = '<div class="text-sm text-gray-500 p-3 text-center">No transactions yet</div>';
        } else {
          list.innerHTML = txs.map(function (t) {
            var credit = t.type === 'credit' || t.type === 'deposit';
            var amt = (credit ? '+$ ' : '-$ ') + Number(t.amount || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            var color = credit ? 'text-green-600' : 'text-red-500';
            var badgeCls = t.status === 'Successful' ? 'bg-green-100 text-green-700' : (t.status === 'In Progress' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-600');
            var icon = credit ? '/wp-user/i/c3.svg' : '/wp-user/i/d3.svg';
            return '<a href="statements.html" class="flex items-center justify-between p-3 rounded-xl hover:bg-gray-50 transition">' +
              '<div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center overflow-hidden">' +
              '<img src="' + icon + '" alt="" class="w-5 h-5" onerror="this.style.display=\'none\'"></div><div>' +
              '<div class="font-medium text-gray-900 text-sm">' + (t.title || 'INWARD TRANSFER') + '</div>' +
              '<div class="text-xs text-gray-500">' + fmtDate(t.createdAt) + '</div></div></div>' +
              '<div class="text-right"><div class="font-medium ' + color + ' text-sm">' + amt + '</div>' +
              '<span class="text-[10px] ' + badgeCls + ' px-2 py-0.5 rounded-full">' + (t.status || 'Successful') + '</span></div></a>';
          }).join('');
        }
      }
    } catch (err) {
      console.error(err);
      var list = document.getElementById('txList');
      if (list) list.innerHTML = '<div class="text-sm text-gray-500 p-3 text-center">No transactions yet</div>';
    }
  }
  document.addEventListener('DOMContentLoaded', loadDashboard);
})();
</script>

</body>
</html>



