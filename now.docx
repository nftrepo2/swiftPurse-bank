<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <meta name="theme-color" content="#fff">
  <title>App - SwiftPurse Bank</title>
  <link rel="icon" type="image/svg+xml" href="https://swiftpursebank.com/wp-api/site/t_8e130165f44db81d6468a6473e71287e.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background: #f7f7f7; }
    #sidenav {
      width: 250px;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }
    #sidenav.closed { transform: translateX(-100%); }
    #overlay {
      transition: opacity 0.3s ease;
      backdrop-filter: blur(2px);
    }
    .main-wrapper {
      transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    @media (min-width: 768px) {
      #sidenav { transform: translateX(0); }
      #sidenav.closed { transform: translateX(-100%); }
      .main-wrapper { margin-left: 250px; }
      .main-wrapper.full { margin-left: 0; }
    }
  </style>
</head>
