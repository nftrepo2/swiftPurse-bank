  <link href="/wp-user/static/css/main.c0006301.css" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="https://swiftpursebank.com/wp-api/site/t_8e130165f44db81d6468a6473e71287e.png">
</head>
<body style="position:relative;background:#f7f7f7">
  <noscript>You need to enable JavaScript to run this app.</noscript>
  <div style="position:absolute;display:flex;align-items:center;justify-content:center;height:100vh;width:100%">
    <div>
      <img src="/wp-user/b/loader.svg" width="250px">
