                        3: 'rgb(var(--chart-3) / <alpha-value>)',
                        4: 'rgb(var(--chart-4) / <alpha-value>)',
                        5: 'rgb(var(--chart-5) / <alpha-value>)',
                    },
                },
                borderColor: {
