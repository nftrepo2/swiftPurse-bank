      <h1 class="text-xl font-semibold text-gray-800 mb-6">Make Payments</h1>
      <div class="space-y-3">
        <a href="#" class="flex items-center justify-between bg-white rounded-2xl p-4 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center"><svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg></div>
            <div><div class="font-medium text-gray-900">Bank Transfer</div><div class="text-sm text-gray-500">From Bank App Or Internet Banking.</div></div>
          </div>
          <div class="flex items-center gap-2"><span class="text-xs text-red-500">Not available for your region</span><svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
        </a>
        <a href="#" class="flex items-center justify-between bg-white rounded-2xl p-4 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center"><svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg></div>
            <div><div class="font-medium text-gray-900">Card</div><div class="text-sm text-gray-500">Add Money With A Debit/Credit Card</div></div>
          </div>
