g":"https://images.pexels.com/photos/221457/pexels-photo-221457.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"London Office Tower","loc":"London Â· UK","val":"$8,900,000","roi":"9.8%","tokens":"18,000","desc":"Grade-A commercial tower in central London. Long-term blue-chip tenants, excellent transport links and stunning city views.","beds":0,"baths":6,"sqft":"12,400","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/325185/pexels-photo-325185.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Lobby","img":"https://images.pexels.com/photos/271624/pexels-photo-271624.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Office Floor","img":"https://images.pexels.com/photos/1181406/pexels-photo-1181406.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Meeting Room","img":"https://images.pexels.com/photos/1181395/pexels-photo-1181395.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Rooftop","img":"https://images.pexels.com/photos/2816499/pexels-photo-2816499.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"City View","img":"https://images.pexels.com/photos/460672/pexels-photo-460672.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"New York Penthouse","loc":"Manhattan, NY Â· USA","val":"$12,500,000","roi":"8.6%","tokens":"25,000","desc":"Iconic Manhattan penthouse with 360-degree skyline views. Private terrace, chef kitchen and full concierge service.","beds":4,"baths":3,"sqft":"3,600","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/2224037/pexels-photo-2224037.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1457842/pexels-photo-1457842.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/2089698/pexels-photo-2089698.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Master Bed","img":"https://images.pexels.com/photos/775219/pexels-photo-775219.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Terrace","img":"https://images.pexels.com/photos/1029599/pexels-photo-1029599.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Skyline View","img":"https://images.pexels.com/photos/466685/pexels-photo-466685.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"Bali Beach Resort","loc":"Seminyak, Bali","val":"$1,800,000","roi":"17.5%","tokens":"3,600","desc":"A tropical paradise resort steps from the Indian Ocean. Private villas, infinity pool and lush garden surroundings.","beds":6,"baths":6,"sqft":"5,200","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/261102/pexels-photo-261102.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Area","img":"https://images.pexels.com/photos/2090644/pexels-photo-2090644.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/1599791/pexels-photo-1599791.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bedroom","img":"https://images.pexels.com/photos/1838554/pexels-photo-1838554.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Infinity Pool","img":"https://images.pexels.com/photos/2373201/pexels-photo-2373201.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Beach View","img":"https://images.pexels.com/photos/1174732/pexels-photo-1174732.jpeg?auto=compress&cs=tinysrgb&w=700"}]},{"name":"Paris City Apartment","loc":"Paris Â· France","val":"$950,000","roi":"11.2%","tokens":"1,900","desc":"Elegant Haussmann-style apartment in the 7th arrondissement. High ceilings, herringbone floors and Eiffel Tower views.","beds":2,"baths":2,"sqft":"1,400","rooms":[{"label":"Exterior","img":"https://images.pexels.com/photos/532826/pexels-photo-532826.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Living Room","img":"https://images.pexels.com/photos/1643384/pexels-photo-1643384.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Kitchen","img":"https://images.pexels.com/photos/1556682/pexels-photo-1556682.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bedroom","img":"https://images.pexels.com/photos/262048/pexels-photo-262048.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Bathroom","img":"https://images.pexels.com/photos/1910472/pexels-photo-1910472.jpeg?auto=compress&cs=tinysrgb&w=700"},{"label":"Eiffel View","img":"https://images.pexels.com/photos/338515/pexels-photo-338515.jpeg?auto=compress&cs=tinysrgb&w=700"}]}];

let propCurrent=0, propPhotoIdx=0;

function openPropertyGallery(idx){
  propCurrent=idx; propPhotoIdx=0;
  const p=PROPS[idx];
  document.getElementById('propGalleryTitle').textContent=p.name;
  document.getElementById('propGalleryDesc').textContent=p.desc;
  const stats=[{lbl:'Value',val:p.val,color:'var(--blue2)'},{lbl:'APY Return',val:p.roi,color:'var(--grn)'},{lbl:'Tokens',val:p.tokens,color:'#fff'}];
  document.getElementById('propGalleryStats').innerHTML=stats.map(s=>`<div style="background:var(--c1);border:1px solid var(--bd);border-radius:10px;padding:12px;text-align:center"><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:.95rem;color:${s.color}">${s.val}</div><div style="font-size:.65rem;color:#444;margin-top:3px;text-transform:uppercase;letter-spacing:.06em">${s.lbl}</div></div>`).join('');
  const meta=[];
  if(p.beds>0)meta.push(['fa-solid fa-bed',p.beds+' Bedrooms']);
  meta.push(['fa-solid fa-bath',p.baths+' Bathrooms']);
  meta.push(['fa-solid fa-ruler-combined',p.sqft+' sqft']);
  meta.push(['fa-solid fa-location-dot',p.loc]);
  document.getElementById('propGalleryMeta').innerHTML=meta.map(([ico,val],i,arr)=>`<div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;${i<arr.length-1?'border-bottom:1px solid #161616;':''}font-size:.81rem"><span style="color:#444;display:flex;align-items:center;gap:7px"><i class="${ico}"></i></span><span style="font-weight:500">${val}</span></div>`).join('');
  renderPropPhoto();
  renderPropThumbs();
  document.getElementById('propGalleryBg').classList.add('open');
  document.body.style.overflow='hidden';
}

function renderPropPhoto(){
  const p=PROPS[propCurrent];
  const room=p.rooms[propPhotoIdx];
  const img=document.getElementById('propMainImg');
  img.style.opacity='0';
  setTimeout(()=>{img.src=room.img;img.style.opacity='1';},150);
  document.getElementById('propRoomLbl').textContent=room.label;
  document.getElementById('propPhotoCount').textContent=(propPhotoIdx+1)+' / '+p.rooms.length;
}

function renderPropThumbs(){
  const p=PROPS[propCurrent];
  document.getElementById('propThumbs').innerHTML=p.rooms.map((r,i)=>`<div onclick="propPhotoIdx=${i};renderPropPhoto();renderPropThumbs()" style="width:60px;height:60px;border-radius:10px;overflow:hidden;border:2px solid ${i===propPhotoIdx?'var(--blue2)':'#1a1a1a'};cursor:pointer;flex-shrink:0;transition:border-color .15s"><img src="${r.img}" alt="${r.label}" style="width:100%;height:100%;object-fit:cover" loading="lazy"/></div>`).join('');
}

function prevPropPhoto(){propPhotoIdx=propPhotoIdx>0?propPhotoIdx-1:PROPS[propCurrent].rooms.length-1;renderPropPhoto();renderPropThumbs();}
function nextPropPhoto(){propPhotoIdx=(propPhotoIdx+1)%PROPS[propCurrent].rooms.length;renderPropPhoto();renderPropThumbs();}
function closePropertyGallery(){document.getElementById('propGalleryBg').classList.remove('open');document.body.style.overflow='';}
function handlePropGalleryBgClick(e){if(e.target===document.getElementById('propGalleryBg'))closePropertyGallery();}

/* â•â• DOMCONTENTLOADED â•â• */
document.addEventListener('DOMContentLoaded',()=>{
  const savedTheme = localStorage.getItem('rwg_theme');
  applyTheme(savedTheme !== 'light');
  if(document.getElementById('tv_chart_container'))
    setTimeout(()=>initMainChart('COINBASE:BTCUSD'),400);
  if(document.getElementById('tv_trade_chart'))
    setTimeout(initTradeChart,400);
  initRotatingTestis();
  if('Notification' in window && Notification.permission === 'default'){
    setTimeout(() => Notification.requestPermission().catch(()=>{}), 3000);
  }
});
</script>

<script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
<script src="../js/convert/config.js"></script>
<script src="../js/convert/auth.js"></script>
<script src="../js/convert/feature-pages.js"></script>
</body>
</html>

