      <button class="flex-shrink-0 bg-blue2 text-white border-none rounded-[8px] px-3 py-[7px] text-[.76rem] font-medium cursor-pointer flex items-center gap-[5px]" onclick="copyCTWallet()"><i class="fa-regular fa-copy"></i> Copy</button>
