      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Profit Share</span><span style="font-weight:600;color:var(--ylw)">${t.profit}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Min. Startup</span><span style="font-weight:600;color:var(--blue2)">${t.min}</span></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">Risk Level</span><span style="font-weight:600">${t.risk}</span></div>
