    <div style="background:#0a0a0a;border:1px solid #1a1a1a;border-radius:11px;overflow:hidden;margin-bottom:14px">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616">
        <span style="font-size:.8rem;color:#555">Win Rate</span>
        <div style="display:flex;align-items:center;gap:10px">${perfBar(t.winrate)}<span style="font-weight:700;color:var(--grn);font-size:.85rem;min-width:42px;text-align:right">${t.winrate}%</span></div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid #161616"><span style="font-size:.8rem;color:#555">ROI</span><span style="font-weight:700;color:var(--grn)">${t.roi}</span></div>
