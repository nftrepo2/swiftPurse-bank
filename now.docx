    </header>

    <main class="flex-1 p-4 md:p-6 max-w-3xl mx-auto w-full">
      <!-- Balance Card -->
      <div class="rounded-2xl p-6 text-white relative overflow-hidden mb-6" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
